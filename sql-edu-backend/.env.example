# 复制本文件为 .env 并填写真实配置，切勿将 .env 提交到 Git

# 邮件（QQ 邮箱示例）
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_mail_auth_code
MAIL_FROM=your_email@example.com
MAIL_PORT=465
MAIL_SERVER=smtp.qq.com
MAIL_STARTTLS=False
MAIL_SSL_TLS=True
# 生产环境保持 false；仅开发/staging 排查 SMTP 时显式开启
ENABLE_MAIL_TEST=false
# 留空则禁用教师邀请码注册；生产环境必须通过 Secret 注入，不要提交真实值
TEACHER_INVITE_CODE=
# 验证码安全策略（生产可通过环境变量调整）
CAPTCHA_EXPIRE_MINUTES=10
CAPTCHA_SEND_INTERVAL_SECONDS=60
CAPTCHA_DAILY_EMAIL_LIMIT=5
CAPTCHA_DAILY_IP_LIMIT=20
CAPTCHA_MAX_VERIFY_ATTEMPTS=5

# 数据库
DEBUG=false
DB_URL=mysql+aiomysql://用户名:密码@127.0.0.1:3306/库名?charset=utf8mb4
BUSINESS_DB_DIALECT=mysql
BUSINESS_DB_VERSION=8.0.46
BUSINESS_DB_CHARSET=utf8mb4
# 生产环境必须保持 false；仅本地排查时显式开启
DB_ECHO=false

# 允许跨域访问的前端 Origin（JSON 数组，不要使用 *）
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# 题目无方言要求且未检测到唯一方言特征时采用的判题引擎
PARSEVAL_DEFAULT_DIALECT=mysql
# auto 会按已解析方言选择原生引擎；仅本地兼容测试可显式设为 sqlite
PARSEVAL_EXECUTION_BACKEND=auto
# 原生判题连接（生产环境请使用受限沙盒账号，并指向隔离执行节点）
PARSEVAL_MYSQL_URL=
PARSEVAL_POSTGRES_URL=
PARSEVAL_TSQL_URL=
PARSEVAL_ORACLE_URL=
PARSEVAL_MYSQL_VERSION=8.0.46
PARSEVAL_POSTGRES_VERSION=16
PARSEVAL_TSQL_VERSION=2022
PARSEVAL_ORACLE_VERSION=23ai
# Optional offline BKT calibration. Leave empty until a real student-event
# JSONL export passes the bounded calibration/held-out checks.
PHASE3_BKT_CALIBRATION_ARTIFACT=
PHASE3_BKT_CALIBRATION_SOURCE=
# Phase 1 worker admission and hard resource limits
PARSEVAL_WORKER_MAX_CONCURRENCY=2
PARSEVAL_WORKER_QUEUE_LIMIT=8
PARSEVAL_WORKER_MEMORY_MB=2048
PARSEVAL_WORKER_CPU_SECONDS=50

# JWT 与密钥（必填，建议用 openssl rand -hex 32 生成）
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# AI 接口
AI_API_KEY=your_ai_api_key
AI_BASE_URL=https://api.openai.com/v1
# 模型名称，统一用于判题提示、对话、题目生成等
AI_MODEL_NAME=gemini-3-pro-high
# chat_completions（默认）或 responses；CC Switch Codex provider 通常使用 responses
AI_WIRE_API=chat_completions
# 可选：本机开发时显式复用 CC Switch 中的一个 provider。只填写路径和 provider id，
# 后端以只读方式加载密钥，不要把真实密钥复制到项目文件中。
AI_CC_SWITCH_DB_PATH=
AI_CC_SWITCH_PROVIDER_ID=
AI_CC_SWITCH_APP_TYPE=codex
AI_CC_SWITCH_MODEL=
# 温度，统一控制所有 AI 调用的随机性（0～1，越高越随机）
AI_TEMPERATURE=0.7
# 教学闭环 LLM（Phase 2 证据复核 + Phase 5 反馈润色）；确认模型/费用后开启
LLM_TEACHING_ENABLED=false
LLM_PHASE2_ENABLED=true
LLM_PHASE5_ENABLED=true
LLM_TIMEOUT_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_INPUT_BYTES=49152
