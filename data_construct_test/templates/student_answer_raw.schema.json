{
  "type": "array",
  "items": {
    "type": "object",
    "required": ["persona", "records"],
    "properties": {
      "persona": {
        "type": "string",
        "enum": [
          "Newbie",
          "Basic_Filter_Student",
          "Agg_Join_Struggler",
          "Logic_Master"
        ]
      },
      "records": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["q_id", "l1", "l2", "predicted_status", "sql", "thought"],
          "properties": {
            "q_id": {
              "type": "integer"
            },
            "l1": {
              "type": "string"
            },
            "l2": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "predicted_status": {
              "type": "string",
              "enum": ["Correct", "Incorrect"]
            },
            "sql": {
              "type": "string"
            },
            "thought": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
