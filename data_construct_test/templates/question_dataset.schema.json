{
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "difficulty", "l1", "l2", "schema", "q", "ans_sql", "source"],
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "description": "全局递增题号，按 PDF 知识点出现顺序排序"
      },
      "difficulty": {
        "type": "number",
        "minimum": 1.0,
        "maximum": 10.0,
        "description": "难度评估值，1.0 最简单，10.0 最复杂"
      },
      "l1": {
        "type": "string",
        "enum": [
          "KP_BASIC",
          "KP_FILTER",
          "KP_ORDER",
          "KP_AGG",
          "KP_JOIN",
          "KP_SUBQUERY",
          "KP_FUNC",
          "KP_ADVANCED"
        ]
      },
      "l2": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "schema": {
        "type": "string",
        "description": "题目涉及的表结构，例如 instructor(ID, name, dept_name, salary)"
      },
      "q": {
        "type": "string",
        "description": "题目自然语言描述"
      },
      "ans_sql": {
        "type": "string",
        "description": "标准答案 SQL"
      },
      "source": {
        "type": "string",
        "description": "来源教材、章节、页码或练习编号"
      }
    }
  }
}
