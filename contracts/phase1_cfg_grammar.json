      {"path": "sql-edu-backend/core/parseval_data_generator.py", "symbol": "extract_ast_diffs"}
    ],
    "parser_predicate": "parser.ok && parser.single_statement && parser.query_only",
    "structural_predicate": "parser.ok && ir.ok && astdiff.representable",
    "semantic_predicate": "PolicyScope && parser.ok && ir.ok && schema.ok && witness.ok && engine.ok && resources.ok",
    "cfg_acceptance_does_not_imply": ["SCHEMA", "WITNESS", "ENGINE", "RESOURCE", "VERDICT"],
