      "feature_families": ["aggregate_group_having", "order_limit_offset_fetch_top"],
      "meaning": "Aggregate/group/HAVING and bounded ordering/limit productions are covered by the aggregate capability."
    },
    "feature.set_subquery_cte": {
      "binding_kind": "cfg_feature_families",
      "feature_families": ["set_operation", "scalar_in_exists_subquery", "correlated_subquery", "cte"],
      "meaning": "Set, scalar/membership/correlation, and CTE productions are covered as one explicitly bounded subquery capability."
    },
    "feature.window_functions": {
      "binding_kind": "cfg_feature_families",
      "feature_families": ["window_function"],
      "meaning": "Window function, named window, partition, ordering, and frame productions are covered by the bounded window capability."
    },
    "freeze.pair_generation_scope": {
      "binding_kind": "freeze_gate",
      "gate_fields": ["generation_failures", "determinate_label_mismatches", "repeat_run_stable", "acceptance_pass"],
      "machine_predicate": "PolicyScope && mutation.generated && equivalence_control.generated",
      "meaning": "The freeze capability is represented by the FrozenPairScope predicate and its four promotion gate fields, not by a CFG production."
    }
  },
  "symbol_scope": {
    "syntax_nonterminals": ["Submission", "Query", "ReadOnlyQuery", "SelectQuery", "WithQuery", "SetQuery", "SelectList", "SelectItem", "FromClause", "Relation", "JoinChain", "JoinClause", "Predicate", "GroupClause", "HavingClause", "WindowClause", "OrderClause", "LimitClause", "Expression", "FunctionCall", "AggregateExpression", "Subquery", "CaseExpression", "WindowExpression"],
    "lexical_terminals": ["IDENTIFIER", "QUALIFIED_IDENTIFIER", "LITERAL", "FUNCTION_NAME", "AGGREGATE_FUNCTION", "SCHEMA_TEXT"],
    "semantic_symbols_outside_cfg": ["SchemaCatalog", "Scope", "Obligation", "WitnessWorld", "Backend", "ExecResult", "Verdict"],
    "semantic_symbols_are_not_cfg_symbols": true
  },
  "implementation_boundary": {
    "parser_entrypoints": [
      {"path": "sql-edu-backend/core/sql_dialect_resolver.py", "symbol": "parse_single_query"},
      {"path": "sql-edu-backend/core/parseval_data_generator.py", "symbol": "_parse_sql_strict"}
    ],
    "structural_entrypoints": [
